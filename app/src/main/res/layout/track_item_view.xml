<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@color/track_background">

    <ImageView
        android:id="@+id/preview"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:contentDescription="@string/preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0"
        android:layout_margin="7dp"
        android:background="@color/preview_placeholder"
        android:scaleType="fitXY"
        />

    <ImageView
        android:id="@+id/state"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/state"
        app:layout_constraintTop_toTopOf="@+id/preview"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintStart_toStartOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        android:layout_margin="7dp"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        tools:src="@drawable/play"
        />

    <TextView
        android:id="@+id/track"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/preview"
        app:layout_constraintBottom_toTopOf="@id/artist"
        app:layout_constraintStart_toEndOf="@+id/preview"
        app:layout_constraintEnd_toStartOf="@id/duration"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/track"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        />

    <TextView
        android:id="@+id/artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/track"
        app:layout_constraintStart_toEndOf="@+id/preview"
        app:layout_constraintEnd_toStartOf="@id/duration"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/artist"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/duration"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/delete"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        android:layout_marginEnd="4dp"
        />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:progressTint="@color/accent_blue"
        android:progressBackgroundTint="@color/preview_placeholder"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/track"
        app:layout_constraintEnd_toStartOf="@id/delete"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        />

    <TextView
        android:id="@+id/progress_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progress"
        app:layout_constraintStart_toStartOf="@id/track"
        app:layout_constraintEnd_toStartOf="@id/delete"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="7dp"
        />

    <ImageButton
        android:id="@+id/delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="@string/delete_track"
        app:tint="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="4dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>